# Dev-only: route TSA/certificate requests through the built-in Vite CORS proxy
VITE_CORS_PROXY_URL=/cors-proxy
VITE_BRAND_NAME=LocalPDFKit
VITE_BRAND_LOGO=images/localpdfkit-mark.svg
VITE_FOOTER_TEXT=(c) 2026 LocalPDFKit. All rights reserved.
VITE_DEFAULT_LANGUAGE=en

VITE_WASM_PYMUPDF_URL=http://127.0.0.1:5173/wasm/pymupdf/
VITE_WASM_GS_URL=http://127.0.0.1:5173/wasm/gs/
VITE_WASM_CPDF_URL=http://127.0.0.1:5173/wasm/cpdf/

VITE_TESSERACT_WORKER_URL=http://127.0.0.1:5173/wasm/ocr/worker.min.js
VITE_TESSERACT_CORE_URL=http://127.0.0.1:5173/wasm/ocr/core
VITE_TESSERACT_LANG_URL=http://127.0.0.1:5173/wasm/ocr/lang-data
VITE_TESSERACT_AVAILABLE_LANGUAGES=eng,chi_sim
VITE_OCR_FONT_BASE_URL=http://127.0.0.1:5173/wasm/ocr/fonts
